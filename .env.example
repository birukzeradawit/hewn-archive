# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Custom or Vercel Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hewn_archive
DB_USER=postgres
DB_PASSWORD=your_password_here

# Vercel Postgres (Automatically set by Vercel)
# POSTGRES_URL=your_vercel_postgres_url
# POSTGRES_PRISMA_URL=your_vercel_postgres_prisma_url
# POSTGRES_NON_POOLING_URL=your_vercel_postgres_non_pooling_url
# POSTGRES_USER=your_vercel_postgres_user
# POSTGRES_HOST=your_vercel_postgres_host
# POSTGRES_PASSWORD=your_vercel_postgres_password
# POSTGRES_DATABASE=your_vercel_postgres_database

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Frontend URL (for CORS)
FRONTEND_URL=https://archive-olive.vercel.app